# Copy this file to  ~/.config/fxlla/config.env  and adjust as needed.
# Any variable here can also be overridden by exporting it in the shell.

# Where models are cached. Unset, fxlla uses ~/.local/share/fxlla/store; models
# run to tens of GB each, so point this at a disk with room. The directory must
# exist (or be creatable) before `fxlla setup`.
# FXLLA_STORE="/Volumes/your-disk/llm"

# Download cap in megabits per second. 25 = ~3.1 MB/s.
FXLLA_RATE_MBIT=25
# Confirm before transferring more than this many GB. At a terminal that is a
# prompt; a script, an agent, or an MCP call gets a refusal telling it to pass
# --yes. Raise it if you want fewer stops.
FXLLA_CONFIRM_ABOVE_GB=5
# Set to 1 to authorize large downloads without being asked. Prefer --yes per
# command; this turns the check off everywhere.
# FXLLA_ASSUME_YES=1
# Pull transfer: aria2 (bandwidth-capped, default) or hf (Hugging Face CLI via
# uvx; robust for xet/LFS repos, no cap). Override per pull with --downloader.
FXLLA_DOWNLOADER=aria2

# Where the local server listens (OpenAI-compatible).
FXLLA_HOST=127.0.0.1
FXLLA_PORT=8080

# Model started by `fxlla on` with no arguments.
FXLLA_DEFAULT_MODEL=qwen3-coder

# Keep-warm: idle minutes before the server auto-stops. 0 = never.
FXLLA_KEEP_WARM=10

# --- GGUF models only (llama-server) ---
FXLLA_CTX=8192          # context size
FXLLA_NGL=999           # layers offloaded to the GPU (999 = all)

# Extra flags for the server (mlx_lm.server or llama-server depending on model).
FXLLA_SERVER_ARGS=""

# --- multi-model gateway (fxlla serve) ---
# First internal port for on-demand backends (each model gets its own).
FXLLA_BACKEND_PORT_BASE=8100
# RAM budget for resident models. Leave unset to derive from the GPU limit.
# FXLLA_GATEWAY_BUDGET_MB=61440

# --- RAG knowledge bases (fxlla kb) ---
# Port for the local embedding server (llama.cpp) used by 'fxlla kb'.
FXLLA_EMBED_PORT=8090
# Which catalog alias supplies the embeddings ('fxlla models', role 'embed').
# Unset means 'embed' (nomic-embed-text v1.5, 768-dim), what every base built so
# far was indexed with. Pull the alias first, then switch. Vectors from two
# models are not comparable, so after changing this re-embed each base with
# 'fxlla kb reindex <name>'; compare candidates with 'fxlla kb eval'.
# FXLLA_EMBED_MODEL=embed-qwen3
# Set to 1 to use the sqlite-vec KNN index for `fxlla kb search` instead of the
# default brute-force cosine scan. It runs rag/core.py under `uv run --with
# sqlite-vec` (uv required) and falls back to the scan when unavailable.
# FXLLA_KB_INDEX=1
# Advanced: force a specific interpreter for rag/core.py (must allow loading
# sqlite extensions for the index). Leave unset to let FXLLA_KB_INDEX decide.
# FXLLA_KB_PYTHON=/path/to/venv/bin/python

# --- model evals (fxlla eval) ---
# Port for the temporary server each evaluated model runs on.
# FXLLA_EVAL_PORT=8097

# --- code graph (fxlla graph) ---
# The graph is stored in an embedded KuzuDB and runs under
# `uv run --with kuzu==0.11.3 --with tree-sitter --with tree-sitter-language-pack`
# by default (kuzu pinned: upstream was archived after the Oct 2025 Apple
# acquisition; tree-sitter parses non-Python languages). Set this to an
# interpreter that already has those packages to skip uv.
# FXLLA_GRAPH_PYTHON=/path/to/venv/bin/python

# RAM reserved for the OS when running `fxlla ram auto` (the rest goes to the GPU).
FXLLA_RAM_RESERVE_MB=8192

# An image sent to a model that cannot read one used to fail in the backend
# ("Only 'text' content type is supported"). The gateway now reads it with a
# model that can and hands the chosen one a description - two models, one
# request. A model that CAN see gets the image untouched, since a description
# is lossier. Set to 0 to go back to failing.
# FXLLA_VISION_ROUTING=0
# Which model does the reading. Unset means the first catalog alias with role
# 'vision' that actually has a multimodal projector on disk.
# FXLLA_VISION_MODEL=vision
# Images one request may carry. Each is read separately with its own timeout.
# FXLLA_VISION_MAX_IMAGES=4

# --- media generation (fxlla media) ---
# Default image model (see `fxlla media models`).
FXLLA_MEDIA_MODEL=z-image-turbo
# Directory holding the mflux-cv binaries (image models, edit, upscale), for
# a custom venv off the PATH. Unset means PATH, where `fxlla setup --media`
# puts them. FXLLA_EDIT_BIN / FXLLA_UPSCALE_BIN still win for their commands.
# FXLLA_MFLUX_BIN_DIR=/path/to/venv/bin
# Hugging Face cache holding the image diffusion weights (empty = HF default).
# FXLLA_MEDIA_HF_HOME=/Volumes/your-disk/huggingface
# Directories holding LoRAs, colon separated. The civitai download directory
# is always searched; add wherever you keep your own (a training project, a
# directory shared with another tool). See: fxlla media loras
# FXLLA_LORA_DIRS=/path/to/project/loras:/path/to/other/loras
# Path to the ltx-2-mlx binary for video; it often lives in a project venv.
# FXLLA_VIDEO_BIN=/path/to/.venv/bin/ltx-2-mlx
# Output directory for generated media (default <FXLLA_STORE>/media).
# FXLLA_MEDIA_OUT=/Volumes/your-disk/media
# Set to 0 to stop the desktop notification a finished (or failed) background
# render posts on macOS. It exists because nothing in MCP can reopen a finished
# agent turn to announce a render, so the model can only tell you when asked.
# With terminal-notifier on PATH, clicking the notification reveals the file in
# Finder; without it the notification is attributed to Finder so a click at
# least opens a file browser rather than Script Editor, which is what owns a
# plain osascript notification and has nothing to do with the render.
# FXLLA_MEDIA_NOTIFY=0
# Seconds a media MCP tool call may block before it answers with a job id.
# Zero, because the quickest render measured here takes about a minute: waiting
# only spends the caller's turn to reach the same job id, and blocks whoever is
# driving from doing anything else meanwhile. Raise it if you would rather short
# renders come back as a path, and keep it under the MCP timeout of whatever is
# calling: past that the client reports a timeout, the render keeps going
# invisibly, and an agent that cannot tell the two apart submits it again.
# FXLLA_MCP_WAIT_S=0
# Voice (text to speech via mlx-audio / Chatterbox):
# interpreter with mlx-audio. Unset, fxlla resolves it: the uv tool venv that
# `fxlla setup --media` installs, else python3. Set only to override.
# FXLLA_VOICE_PYTHON=/path/to/venv/bin/python
# a reference voice wav that sets the timbre (required for voice),
# FXLLA_VOICE_REF=/path/to/reference-voice.wav
# and the default language code.
FXLLA_VOICE_LANG=en

# Hugging Face token, only for gated repositories. Leave unset otherwise.
# HF_TOKEN=hf_xxx

# Civitai API token, for `fxlla pull civitai:<id>` (LoRAs, checkpoints).
# CIVITAI_TOKEN in civitai.com account settings. Leave unset otherwise.
# FXLLA_CIVITAI_TOKEN=
